# Copy this file to ".env" and fill in your own values. ".env" is ignored by git.

# --- MySQL (used by docker-compose.yml and by the Java app) ---
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=api_paises
MYSQL_PORT=3306
TZ=America/Guayaquil

# --- REST Countries API v5 (get a free key at https://restcountries.com/sign-up) ---
REST_COUNTRIES_API_KEY=rc_live_your_key_here
